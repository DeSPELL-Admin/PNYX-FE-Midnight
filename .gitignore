# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# omc
.omc/
docs/

# gjc (local agent/session runtime state)
.gjc/

# claude code (local agent state)
.claude/

# compiled contract assets are synced from ../PNYX-Contract (scripts/sync-contract.sh)
public/zk/
src/midnight/contract/*/

# pnpm 전용 프로젝트 — npm lockfile 재생성 방지
/package-lock.json
