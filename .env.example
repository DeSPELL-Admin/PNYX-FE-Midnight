# === Application ===
# 신규 인증 BE 의 base URL(호스트까지만 — 클라이언트가 /api/v1 prefix 를 자동 부착).
# 비우면 same-origin(/api/v1/...) 으로 동작. 예) https://api-staging.pnyx.despell.io
NEXT_PUBLIC_API_URL=
# 앱 공개 base URL(공유 카드/OG/매니페스트용). 예) https://pnyx.despell.io
NEXT_PUBLIC_URL=
# 외부 BE 가 게이트웨이 API 키를 요구할 때만 설정(있으면 X-API-Key 헤더로 부착). 쿠키 JWT 와 무관.
NEXT_PUBLIC_API_KEY=

# API 세대 (롤백 스위치). "v1"=신규 인증 BE(/api/v1), "legacy"=구 클라이언트 롤백. 미설정 시 v1.
NEXT_PUBLIC_API_GENERATION=v1

# === Mock data (BE 미연결 시 활성화) ===
# "true" 로 두면 api.tournaments / api.files 호출이 네트워크 대신 _mocks/ 픽스처를 반환.
NEXT_PUBLIC_USE_MOCK=false

# === Chain selection ===
# "production" → 메인넷만 노출, 그 외 → testnet + mainnet 둘 다 노출
NEXT_PUBLIC_CHAIN_ENV=development
# Deploy mode (매니페스트/배지/피쳐 게이팅용). dev 도메인이 prod 빌드를 띄우는 케이스가
# 흔해서 CHAIN_ENV 와 별도 변수로 관리.
NEXT_PUBLIC_DEPLOY_MODE=development

# === Wallet ===

# === Contracts (체인별 분리. 빈 값은 ZERO_ADDRESS 로 흡수) ===
# Midnight (Lace) — see midnight/PNYX-Contract/scripts/output/preprod-deployment-info.json
NEXT_PUBLIC_MIDNIGHT_NETWORK=preprod
NEXT_PUBLIC_CONTRACT_TOURNAMENT_FINALIZER_MIDNIGHT=d46fd93f1a2426966b3437e099d788ed936d76ea97b1dab49910bb2716c27bf4
# fallback when the wallet has no proof server configured (demo: PNYX-hosted)
NEXT_PUBLIC_MIDNIGHT_PROOF_SERVER_URL=http://127.0.0.1:6300
# 컨트랙트 공개 상태 조회용 인덱서. 브라우저는 기본적으로 같은 오리진의 /midnight-indexer/graphql 프록시를
# 쓰고(next.config.ts rewrites), 프록시 업스트림은 MIDNIGHT_INDEXER_UPSTREAM 으로 바꾼다. 브라우저가 직접
# 부를 URL 을 강제하려면 NEXT_PUBLIC_MIDNIGHT_INDEXER_URL 을 준다(CORS 허용된 곳이어야 함).
# MIDNIGHT_INDEXER_UPSTREAM=https://indexer.preprod.midnight.network/api/v4/graphql
# NEXT_PUBLIC_MIDNIGHT_INDEXER_URL=

# === Feature flags (src/lib/feature-flags.ts) ===
# 일반 웹에서 Startale 수동 연결 버튼 노출(iframe 안에서는 플래그와 무관하게 AutoConnect 처리).
NEXT_PUBLIC_USE_STARTALE_WALLET=false
# 포인트 UI(My Point 카드 + /mypage/points 진입) 게이팅. true 여야 노출.
NEXT_PUBLIC_USE_STARTALE_POINTS=false
# Startale 계정 추상화(AA) 사용.
NEXT_PUBLIC_USE_STARTALE_AA=false
# 디버그 로그(피쳐 플래그 콘솔 출력 등).
NEXT_PUBLIC_DEBUG_MODE=false

# === Analytics ===
NEXT_PUBLIC_GA_MEASUREMENT_ID=    # GA4 측정 ID (G-XXXX). 비우면 GA 미주입.